{
  "name": "MotionEngine",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
  "postCreateCommand": "pip install --upgrade pip && pip install -e '.[dev,api,chat]' && pre-commit install || true",
  "forwardPorts": [8000],
  "portsAttributes": {"8000": {"label": "MotionEngine API"}},
  "containerEnv": {"MPLBACKEND": "Agg", "QT_QPA_PLATFORM": "offscreen"},
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.mypy-type-checker", "charliermarsh.ruff"],
      "settings": {"python.testing.pytestEnabled": true, "python.testing.pytestArgs": ["tests"]}
    }
  }
}
