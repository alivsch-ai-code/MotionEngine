// {{LABEL}}: custom node ({{KIND}}) for vdsim, generated by vdsim.runtime.create_custom_node().
//
// Graph spec: "cpp:<path to this folder>" - vdsim compiles all .cpp files of the folder into a
// shared library (MSVC: cl /LD /O2 /EHsc /std:c++17, otherwise g++/clang++ -shared -fPIC) and
// hot-reloads it when a source file changes. vdsim_node.h is generated from vdsim.framework.types.
#include "vdsim_node.h"

// node description: ports (order = buffer order) and parameters (order = create() array)
static const char* INFO = R"json({{INFO_JSON}})json";

{{PORT_CONSTS}}

class {{CLASS}} : public vdsim::Node {
 public:
  {{CLASS}}(const double* p, size_t n) : gain_(vdsim::param(p, n, 0, 1.0)) {}

  void reset(double dt, uint64_t seed) override {
    dt_ = dt;
    (void)seed;
    steps_ = 0;
  }

{{BODY}}

  std::vector<double> get_state() const override { return {static_cast<double>(steps_)}; }
  void set_state(const double* d, size_t n) override {
    if (n >= 1) steps_ = static_cast<long long>(d[0]);
  }

 private:
  double gain_;
  double dt_ = 0.01;
  long long steps_ = 0;
};

VDSIM_EXPORT_NODE({{CLASS}}, INFO)
